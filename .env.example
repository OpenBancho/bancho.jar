DB_HOST=localhost
DB_USER=bancho
DB_PASS=changeme
DB_NAME=bancho
DB_PORT=3306
DB_TIMEZONE=UTC

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASS=
REDIS_DB=0

# It will send a post to your url with score obj and beatmap bytes (Optional) reponse with pp value for own system

# OSU_NATIVE || WEB_SERVICE@127.0.0.1:8300
PP_CALCULATOR=OSU_NATIVE

# IPAPI, MAXMIND (recommended db downloads automatically)
GEO_PROVIDER=MAXMIND 

PORT=8200
# without protocol
DOMAIN=changeme.com
# DEV, PROD
LEVEL=PROD

OSU_API_KEY=changeme

DIRECT_SEARCH=https://osu.direct/api/search
DIRECT_DL=https://osu.direct/d

INGAME_REGISTRATION_ENABLED=true
ONLY_SEND_HELP_DM=false

# Supported Providers: NONE, TURNSTILE, RECAPTCHA
CAPTCHA_PROVIDER=NONE
CAPTCHA_SECRET_KEY=

# IRC gateway (connect with HexChat/mIRC etc.)
IRC_ENABLED=true
IRC_PORT=6667

# OAuth2
OAUTH_ACCESS_TTL_MINUTES=60
OAUTH_REFRESH_TTL_DAYS=30

# BSS
BSS_ENABLED=true
# Keep it well above the highest official osu! id.
BSS_ID_OFFSET=1000000000
BSS_MAX_PENDING_SETS=10
BSS_MAX_UPLOAD_SIZE_MB=100

# more configuration in .config/ directory