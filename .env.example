DB_HOST=localhost
DB_USER=bancho
DB_PASS=changeme
DB_NAME=bancho
DB_PORT=3306
DB_TIMEZONE=UTC

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASS=
REDIS_DB=0

# Public API auth (OAuth2, tokens stored in Redis)
# Lifetime of an access token. Keep it short; refresh tokens do the long-term work.
OAUTH_ACCESS_TTL_MINUTES=60
# Lifetime of a refresh token. Every refresh rotates it and resets this window.
OAUTH_REFRESH_TTL_DAYS=30

# For the Web Service you can use your own pp system
# It will send a post to your url with score obj and beatmap bytes (Optional)

# OSU_NATIVE || WEB_SERVICE@127.0.0.1:8300
PP_CALCULATOR=OSU_NATIVE

# IPAPI, MAXMIND (recommended db downloads automatically)
GEO_PROVIDER=MAXMIND 

PORT=8200
# without protocol
DOMAIN=changeme.com
# DEV, PROD
LEVEL=PROD

OSU_API_KEY=changeme

DIRECT_SEARCH=https://osu.direct/api/search
DIRECT_DL=https://osu.direct/d

INGAME_REGISTRATION_ENABLED=true

# If true, Bancho Bot never sends help messages in public channels
ONLY_SEND_HELP_DM=false

# IRC gateway (connect with HexChat/mIRC etc.)
IRC_ENABLED=true
IRC_PORT=6667

# Beatmap Submission System (in-game beatmap uploading)
BSS_ENABLED=true
# Ids at or above this value belong to locally submitted content.
# Keep it well above the highest official osu! id.
BSS_ID_OFFSET=1000000000
# How many unranked sets a single user may have submitted at once
BSS_MAX_PENDING_SETS=10
# Maximum size of a single upload. Keep nginx client_max_body_size in sync.
BSS_MAX_UPLOAD_SIZE_MB=100

# more configuration in .config/ directory